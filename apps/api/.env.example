PORT=3001
DATABASE_URL=postgresql://motion_user:change_me_local_password@localhost:5432/flowxis?schema=public
REDIS_URL=redis://localhost:6379
JWT_SECRET=change_me_jwt_secret_at_least_32_characters_long_for_dev
GOOGLE_CLIENT_ID=mock_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=mock_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback
FRONTEND_URL=http://localhost:3000
ADMIN_EMAILS=admin@flowxis.vn
COOKIE_SECURE=true

# Khóa HMAC băm IP và deviceId chống lạm dụng (đổi ở production)
# Production bắt buộc đặt, >= 32 ký tự, KHÔNG dùng chung JWT_SECRET (thiếu thì đăng ký mới sẽ lỗi).
ANTI_ABUSE_SECRET=change_me_anti_abuse_secret_at_least_32_characters_long
# Rate-limit route đăng nhập theo IP khách
AUTH_THROTTLE_LIMIT=20
AUTH_THROTTLE_TTL_MS=60000
# CIDR proxy tin cậy bổ sung ngoài dải Cloudflare (dùng cho test), phân tách bằng dấu phẩy
# BẮT BUỘC khi API chạy sau Caddy/nginx/Docker bridge: liệt kê CIDR reverse proxy, nếu không mọi user dùng chung một IP.
TRUSTED_PROXY_CIDRS=

# Cloudflare R2 (S3-compatible). Bucket riêng tư; cấu hình CORS/lifecycle bằng:
#   pnpm --filter @flowxis/api run build && node apps/api/dist/scripts/configure-bucket.js
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=flowxis
# Tùy chọn: ghi đè endpoint (mặc định https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com)
R2_ENDPOINT=

# RunningHub. Không có RUNNINGHUB_API_KEY thì dùng adapter "chưa cấu hình" (mọi lời gọi ném RH_ERROR).
# API key tạo ở trang API Key của RunningHub; không commit giá trị thật.
RUNNINGHUB_API_KEY=
# Tùy chọn: ghi đè host (mặc định https://www.runninghub.ai)
RUNNINGHUB_API_HOST=
# ID workflow Face Swap trên RunningHub; nodeId/fieldName đối chiếu ở pipelines/pipeline-config.ts
RUNNINGHUB_WORKFLOW_FACESWAP=
# Cách gọi Face Swap: ai-app (mặc định, /openapi/v2/run/ai-app/{id}) hoặc workflow (/openapi/v2/run/workflow/{id})
# Loại máy RunningHub: default (Standard 0.88 USD/giờ), plus (1.18), ultra (2.35)
RUNNINGHUB_INSTANCE_FACE_SWAP=default
# Đổi trang phục (AI App 2012848202482978818)
RUNNINGHUB_WORKFLOW_OUTFIT_CHANGE=
RUNNINGHUB_INSTANCE_OUTFIT_CHANGE=default
# ID workflow Body Retouch (bắt buộc: thiếu thì api và worker không khởi động)
RUNNINGHUB_WORKFLOW_BODY_RESHAPE=2095511080751996930
# Cách gọi Body Retouch: ai-app (mặc định) hoặc workflow
# Loại máy RunningHub: default (Standard 0.88 USD/giờ), plus (1.18), ultra (2.35)
RUNNINGHUB_INSTANCE_BODY_RETOUCH=default
# ID workflow Motion Control (bắt buộc: thiếu thì api và worker không khởi động)
RUNNINGHUB_WORKFLOW_MOTION=
# Cách gọi Motion Control: ai-app (mặc định) hoặc workflow
# AI App ID hiện dùng: 2122377113419743233
# Loại máy RunningHub: default (Standard 0.88 USD/giờ), plus (1.18), ultra (2.35)
RUNNINGHUB_INSTANCE_MOTION_CONTROL=default
# Motion Control v2 (AI App 2083697864529678338)
RUNNINGHUB_WORKFLOW_MOTION_V2=
RUNNINGHUB_INSTANCE_MOTION_CONTROL_V2=default
# Xóa watermark/logo/phụ đề (AI App 2054124567815303169; không bắt buộc, trống thì Task lỗi GPU_ERROR)
RUNNINGHUB_WORKFLOW_REMOVE_WATERMARK=
RUNNINGHUB_INSTANCE_REMOVE_WATERMARK=default
# Số Task tối đa đã qua cổng đồng thời (gồm orphan còn hạn) và cũng là số job BullMQ chạy song song của worker.
# Enterprise-Shared cho 100; production đặt 85 để chừa chỗ cho lỗi 421.
RH_MAX_CONCURRENT=2
# Chỉ đặt khi cần số job BullMQ khác RH_MAX_CONCURRENT (không khuyến nghị: job thừa sẽ giữ slot chờ cổng).
# WORKER_CONCURRENCY=2
# Kích thước pool PostgreSQL mỗi tiến trình (mặc định 10; worker production 30)
# DB_POOL_MAX=10
# Chu kỳ thử lại khi cổng đầy (ms)
RH_GATE_RETRY_MS=5000
# Chu kỳ poll kết quả RunningHub (ms)
RH_POLL_INTERVAL_MS=3000
# Số dư RunningHub: cảnh báo khi dưới ngưỡng (coin); endpoint đọc số dư (chưa có giá trị).
RH_BALANCE_ALERT_USD=10
RH_BALANCE_ENDPOINT=/uc/openapi/accountStatus

# Nạp credit VietQR: tài khoản nhận tiền (BẮT BUỘC để tạo đơn nạp; chưa có giá trị thật thì [ASSUMPTION])
# BIN ngân hàng NAPAS 6 chữ số (ví dụ 970422 = MB)
TOPUP_BANK_BIN=
TOPUP_BANK_ACCOUNT_NO=
TOPUP_BANK_ACCOUNT_NAME=
# Rate-limit POST /topups
TOPUP_THROTTLE_LIMIT=10
TOPUP_THROTTLE_TTL_MS=60000

# Tùy chọn: Discord webhook báo Admin (đơn nạp pending/quá hạn, cảnh báo đối soát). Trống = chỉ ghi log. KHÔNG commit giá trị thật.
DISCORD_WEBHOOK_URL=

# Giới hạn |amount| mỗi lần Admin cộng/trừ bù credit (mặc định 30000).
ADMIN_ADJUST_MAX=30000

# Thống kê Admin: quy đổi chi phí GPU thật (USD, RunningHub Enterprise-Shared) sang VNĐ.
# Tỉ giá USD→VNĐ lấy tự động từ API (cache 1 giờ); USD_VND là giá trị dự phòng khi API lỗi.
USD_VND=25000
# Email tài khoản benchmark/thử nghiệm (phân tách dấu phẩy) bị loại khỏi scope real.
BENCHMARK_USER_EMAILS=
# Veo 3 (API model chuẩn): tên model, để trống = rhart-video-v3.1-pro
RUNNINGHUB_VEO3_MODEL=
RUNNINGHUB_INSTANCE_VEO3=default
# Muse Video (API model chuẩn, chỉ image-to-video): tên model, để trống = meta/muse-video/economy
RUNNINGHUB_MUSE_VIDEO_MODEL=
RUNNINGHUB_INSTANCE_MUSE_VIDEO=default
